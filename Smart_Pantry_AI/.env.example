# Copy to .env and fill in your own keys. Never commit .env.

GEMINI_API_KEY=
RECIPE_GEMINI_MODEL=gemini-3.5-flash
RECIPE_GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# Optional free-tier fallback for recipe generation.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Shared secret for a hosted backend; the app must be built with the same
# value via --dart-define=RECIPE_AGENT_TOKEN=... Leave empty for local use.
RECIPE_AGENT_TOKEN=
